# ============================================================
# 环境变量示例 —— 复制为 .env 或在 Vercel 项目设置 > Environment
# Variables 中逐项配置。切勿把真实密钥提交到 Git 仓库。
# ============================================================

# --- 询价线索后台口令(api/leads.js,必填才能查看线索)---
# 自己起一段长口令即可,例如 openssl rand -hex 24 的输出。
# 没配置时:访客仍能正常提交线索,但 /dashboard 打不开。
LEADS_ADMIN_KEY=

# --- 数据存储(api/leads.js、api/view-counter.js)---
# 线索与浏览量都存在 Redis 里。接入 Vercel 的 Upstash 集成后会自动注入
# qhdlv_KV_REST_API_URL / qhdlv_KV_REST_API_TOKEN,通常无需手工填写。
# 自建 Upstash 时才填下面两项(代码按 UPSTASH_ > qhdlv_KV_ > KV_ 顺序取用)。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI 聊天助手（api/chat.js）---
# 获取地址：https://platform.agnes-ai.com
AGNES_API_KEY=

# --- 天气与潮汐（api/weather.js、api/tide.js,可选）---
# 和风天气开发者控制台：https://console.qweather.com
# 不填也能用:天气会自动改走免费的 Open-Meteo,潮汐降级(跳过日出日落与钓鱼指数)。
QWEATHER_API_KEY=
QWEATHER_API_HOST=
