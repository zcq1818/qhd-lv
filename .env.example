# ============================================================
# 环境变量示例 —— 复制为 .env 或在 Vercel 项目设置 > Environment
# Variables 中逐项配置。切勿把真实密钥提交到 Git 仓库。
# ============================================================

# --- AI 聊天助手（api/chat.js）---
# 获取地址：https://platform.agnes-ai.com
AGNES_API_KEY=your_api_key_here

# --- 天气与潮汐（api/weather.js、api/tide.js）---
# 和风天气开发者控制台：https://console.qweather.com
# 两项都必填，缺失时天气接口返回 500、潮汐接口降级（跳过日出日落与钓鱼指数）
QWEATHER_API_KEY=your_qweather_key_here
QWEATHER_API_HOST=your-host.re.qweatherapi.com

# --- 浏览量计数（api/view-counter.js，可选）---
# 任选一组：Upstash Redis（推荐）或 Vercel KV
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
